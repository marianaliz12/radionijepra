# Copia este archivo como ".env" y ajusta los valores.

# Puerto donde corre la aplicación
PORT=3000

# Administrador inicial (solo se usa la primera vez, cuando la base de datos está vacía).
# Al entrar por primera vez, la plataforma obliga a cambiar la contraseña.
ADMIN_NAME=Coordinación Radio NIJEPRA
ADMIN_EMAIL=admin@nijepra.edu.co
ADMIN_PASSWORD=CambiaEstaClave2026

# Asistente con inteligencia artificial (opcional).
# Sin clave, el asistente responde con las preguntas frecuentes del proyecto.
# La clave se crea en https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Pon "true" cuando la página se publique con HTTPS
COOKIE_SECURE=false

# Carpeta donde se guarda la base de datos (por defecto ./data)
# DATA_DIR=/var/lib/radio-nijepra
